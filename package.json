    "lint:fix": "eslint --fix .",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint",
    "fix": "pnpm format && pnpm lint:fix"
  },
